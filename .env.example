# -----------------------------------------------------------------------------
# Sangam Residency - Production & SEO Environment Variables Template
# -----------------------------------------------------------------------------

# Primary Production Domain (No trailing slash)
# Example: https://sangamresidency.com
NEXT_PUBLIC_SITE_URL=https://sangamresidency.com

# Google Search Console Verification Token (HTML Tag / Meta Content)
# Get from: https://search.google.com/search-console
# Example: aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools Verification Token
# Get from: https://www.bing.com/webmasters
# Example: 1234567890ABCDEF1234567890ABCDEF
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (Optional)
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
